    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "readOnlyHint": false,
    },
    "description": "Rename one project by its immutable projectID. Renaming does not change the ID or detach any notes.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "projectID": {
          "description": "The immutable project UUID returned by project_create or project_list.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "projectName": {
          "description": "The project's unique current name. Prefer projectID when retaining a long-lived reference.",
          "maxLength": 120,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "projectID",
        "projectName",
      ],
      "type": "object",
    },
    "name": "project_update",
    "title": "Rename a memory project",
  },
]
`;
