{
  "name": "@vaur94/agz-memory-plugin",
  "version": "0.4.1",
  "description": "Safe automatic memory capture and bounded context injection for OpenCode V2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.tr.md"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --target bun --format esm --packages external --outfile dist/index.js && bunx tsc -p tsconfig.build.json",
    "check": "bunx tsc --noEmit",
    "prepack": "bun run check && bun run build"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ugur-murat-alt/agz-memory.git",
    "directory": "packages/opencode-plugin"
  },
  "homepage": "https://github.com/ugur-murat-alt/agz-memory#readme",
  "bugs": {
    "url": "https://github.com/ugur-murat-alt/agz-memory/issues"
  },
  "dependencies": {
    "@opencode-ai/plugin": "0.0.0-beta-18743",
    "@vaur94/agz-memory": "0.4.1"
  }
}
